APP_NAME="Chatterie Ô Coeur Blanc"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost/coeur-blanc/public
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Europe/Paris

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coeur_blanc
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="les.aristocats@outlook.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Destinataire des demandes de pre-reservation
ELEVAGE_MAIL=les.aristocats@outlook.fr
